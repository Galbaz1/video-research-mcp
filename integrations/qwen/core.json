  "expected_tools": [
    {
      "name": "crop",
      "input_schema": {
        "properties": {
          "image_path": {
            "description": "Absolute path to the source image file",
            "type": "string"
          },
          "box": {
            "description": "Crop region as [x1, y1, x2, y2] in normalized coordinates (0-1000)",
            "items": {
              "type": "integer"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "output_path": {
            "description": "Where to save the cropped image. Defaults to {stem}_cropped.{ext} next to the\noriginal.",
            "type": "string"
          }
        },
        "required": [
          "image_path",
          "box"
        ],
        "type": "object"
      }
    },
    {
      "name": "draw_bbox",
      "input_schema": {
        "properties": {
          "image_path": {
            "description": "Absolute path to the source image file",
            "type": "string"
          },
          "bboxes": {
            "description": "Boxes to draw. Each item has bbox=[x1, y1, x2, y2] in normalized coordinates\n(0-1000), an optional label above the box, and an optional hex color such as\n'#FF0000'. Omitted colors cycle through the default palette.",
            "items": {
              "properties": {
                "bbox": {
                  "items": {
                    "type": "integer"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                },
                "label": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              },
              "required": [
                "bbox"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "output_path": {
            "description": "Where to save the annotated image. Defaults to {stem}_annotated.{ext} next to\nthe original.",
            "type": "string"
          }
        },
        "required": [
          "image_path",
          "bboxes"
        ],
        "type": "object"
      }
    },
    {
      "name": "save_view",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "Absolute path to the source document or video.",
            "type": "string"
          },
          "pages": {
            "description": "Page range for documents, e.g. '1', '1-5', '2,4,7'. Default: '1'. Ignored for video.",
            "type": "string"
          },
          "times": {
            "description": "Timestamps for video frames \u2014 seconds (52, 58.5) or a clock string\n('MM:SS'/'HH:MM:SS'). Required for video. Ignored for docs.",
            "items": {
              "type": [
                "number",
                "string"
              ]
            },
            "type": "array"
          },
          "dpi": {
            "description": "Render resolution for document pages (default 200). Ignored for video (native).",
            "type": "integer"
          },
          "budget": {
            "default": "normal",
            "description": "Resolution of the returned previews (the saved files are always full/native).",
            "enum": [
              "small",
              "normal",
              "large"
            ],
            "type": "string"
          },
          "output_dir": {
            "description": "Directory to write the images to. Default: next to the source file.",
            "type": "string"
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      }
    },
    {
      "name": "read_image",
      "input_schema": {
        "properties": {
          "image_path": {
            "description": "Absolute path to the image file",
            "type": "string"
          },
          "budget": {
            "default": "normal",
            "description": "Resolution preset: small (~512\u00d7512), normal (~1024\u00d71024), large (~1448\u00d71448).",
            "enum": [
              "small",
              "normal",
              "large"
            ],
            "type": "string"
          }
        },
        "required": [
          "image_path"
        ],
        "type": "object"
      }
    },
    {
      "name": "media_info",
      "input_schema": {
        "properties": {
          "path": {
            "description": "Absolute path to the media file (video or audio)",
            "type": "string"
          },
          "raw": {
            "default": false,
            "description": "Also return the raw ffprobe JSON (format + streams + chapters) for fields not covered\nby the summary. Default: false",
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    {
      "name": "read_video",
      "input_schema": {
        "properties": {
          "video_path": {
            "description": "Absolute path to the video file",
            "type": "string"
          },
          "fps": {
            "default": 0,
            "description": "Sampling FPS. 0 = auto-detect based on duration (recommended). Default: 0",
            "type": "number"
          },
          "max_frames": {
            "default": 600,
            "description": "Maximum frames to extract (capped at 600). Actual count may be lower or stripped\ndepending on video length and response size limits.",
            "type": "integer"
          },
          "budget": {
            "default": "normal",
            "description": "Per-frame resolution preset: small (~288\u00d7288), normal (~512\u00d7512), large\n(~1024\u00d71024).",
            "enum": [
              "small",
              "normal",
              "large"
            ],
            "type": "string"
          },
          "start_time": {
            "description": "Start time \u2014 seconds or a clock string ('MM:SS'/'HH:MM:SS'). Default: 0\n(beginning).",
            "type": [
              "number",
              "string"
            ]
          },
          "end_time": {
            "description": "End time \u2014 seconds or a clock string ('MM:SS'/'HH:MM:SS'). Default: end of video.",
            "type": [
              "number",
              "string"
            ]
          }
        },
        "required": [
          "video_path"
        ],
        "type": "object"
      }
    },
    {
      "name": "visualize",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "Absolute path to the file to visualize.",
            "type": "string"
          },
          "pages": {
            "description": "Page range for multi-page documents (e.g. '1-5', '3', '1,3,5-8'). 1-based. Default:\nfirst 20 pages.",
            "type": "string"
          },
          "budget": {
            "default": "large",
            "description": "Resolution preset per page/image: small (~512x512), normal (~1024x1024), large\n(~1448x1448).",
            "enum": [
              "small",
              "normal",
              "large"
            ],
            "type": "string"
          },
          "max_pages": {
            "default": 20,
            "description": "Maximum number of pages to render (default 20).",
            "type": "integer"
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      }
    }
  ],
